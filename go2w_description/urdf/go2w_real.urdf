  <gazebo reference="FL_foot"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="FR_foot"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="RL_foot"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="RR_foot"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/lidar</topic>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26179938779</min_angle>
            <max_angle>0.26179938779</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>/imu</topic>
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
</robot>
